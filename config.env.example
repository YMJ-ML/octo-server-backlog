# AINOL Agent Architecture - Configuration Example
# Copy this file to config.env and fill in your actual values

# ============================================================================
# GitHub Configuration
# ============================================================================
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO_OWNER=your_org_or_username
GITHUB_REPO_NAME=your_repo_name
GITHUB_REPO_URL=https://github.com/your_org_or_username/your_repo_name

# ============================================================================
# AI Platform Configuration
# ============================================================================

# Kimi (moonshot.cn)
KIMI_API_KEY=your_kimi_api_key_here
KIMI_API_URL=https://api.moonshot.cn/openai/v1
KIMI_MODEL=moonshot-v1-8k

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 元宝 (Baidu AI)
YUANPAO_API_KEY=your_yuanpao_api_key_here
YUANPAO_API_URL=https://api.baidu.com/api/v1
YUANPAO_MODEL=eb-instant

# 千问 (Alibaba Qwen)
QIANWEN_API_KEY=your_qianwen_api_key_here
QIANWEN_API_URL=https://dashscope.aliyuncs.com/api/v1
QIANWEN_MODEL=qwen-max

# 百度 AI (Wenxin)
BAIDU_AI_API_KEY=your_baidu_ai_api_key_here
BAIDU_AI_SECRET_KEY=your_baidu_ai_secret_key_here
BAIDU_AI_MODEL=ernie-4.0-turbo-8k

# 豆包 (ByteDance)
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_API_URL=https://api.doubao.com/v1
DOUBAO_MODEL=doubao-pro

# ============================================================================
# Polling & Scheduling Configuration
# ============================================================================

# GitHub 轮询间隔（秒）
GITHUB_POLL_INTERVAL=300

# 并发请求数（AI 平台调用）
CONCURRENT_REQUESTS=3

# 请求超时时间（秒）
REQUEST_TIMEOUT=30

# ============================================================================
# PM 链路配置
# ============================================================================

# PM 平台 API 端点（根据实际需求调整）
PM_API_URL=https://pm.example.com/api
PM_API_TOKEN=your_pm_api_token_here

# PM 项目 ID
PM_PROJECT_ID=project_id_here

# ============================================================================
# 日志配置
# ============================================================================

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/ainol.log

# 是否同时输出到控制台
LOG_TO_CONSOLE=true

# ============================================================================
# 知识库配置
# ============================================================================

# 知识库文件路径（相对于项目根目录）
KNOWLEDGE_BASE_PATH=./AINOL_Knowledge_Base_9_Domains.md

# 知识库更新间隔（秒）
KNOWLEDGE_BASE_REFRESH_INTERVAL=3600

# ============================================================================
# 缓存配置
# ============================================================================

# 缓存类型: memory, redis, sqlite
CACHE_TYPE=memory

# 缓存过期时间（秒）
CACHE_TTL=600

# Redis 配置（仅当 CACHE_TYPE=redis 时需要）
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# 环境标识
# ============================================================================

# 运行环境: development, staging, production
ENVIRONMENT=development

# 项目名称
PROJECT_NAME=AINOL Agent Architecture

# 版本号
VERSION=1.0.0
