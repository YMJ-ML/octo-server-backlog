# AINOL octo-server 产品管家 Agent - 配置模板
# 复制为 config.env 后填入真实值：cp config.env.example config.env
# 注意：config.env 不要提交到 GitHub

# ==================== GitHub ====================
# 需求池仓库（可写）
BACKLOG_REPO=YMJ-ML/octo-server-backlog

# 目标源码仓库（只读）
SOURCE_REPO=Mininglamp-OSS/octo-server

# GitHub Token（只写本地，不进群、不进git）
GITHUB_TOKEN=your_github_token_here

# Bot自己在GitHub上的login，用于过滤自己打标签/评论造成的自触发
# 多个用英文逗号分隔
BOT_GITHUB_LOGINS=YMJ-ML

# ==================== 轮询 ====================
# 每5分钟轮询一次
POLL_INTERVAL=300
STATE_FILE=issue_state.json
LOG_DIR=logs

# ==================== Octo 考试群 ====================
# 考试群ID（临近考试由主考提供）
OCTO_EXAM_GROUP=your_exam_group_id_here

# 主考UID与显示名（所有变化通知都@主考）
OCTO_MAIN_EXAMINER=your_examiner_uid_here
OCTO_MAIN_EXAMINER_NAME=主考

# 三个Bot账号/robot_id（按实际OpenClaw配置填写）
BOT_PRODUCT=288xq13tm5a4f369a69_bot
BOT_PRD=288zjw1tfpzd99e9672_bot
BOT_REVIEW=288zkcwrkt862dbd28c_bot

# 可选：GitHub login 到 Octo uid 的映射，用于@提issue的人/操作人
# 格式：githubLogin:octoUid:显示名,githubLogin2:octoUid2:显示名2
# 没配置时，仍会@主考，正文里保留issue链接和操作者login
GITHUB_TO_OCTO_UIDS=

# ==================== Question 分支 ====================
# question回答后，如果无人追问/确认，多少天后可自动关单（当前代码先预留）
QUESTION_AUTO_CLOSE_DAYS=7

# ==================== 知识库 ====================
KNOWLEDGE_BASE_PATH=./AINOL_Knowledge_Base_9_Domains_V2.md

# ==================== 环境 ====================
ENVIRONMENT=exam
PROJECT_NAME=AINOL octo-server PM Agent
VERSION=5.0.0
